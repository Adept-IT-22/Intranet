FROM node:20-alpine AS build
WORKDIR /app
COPY Intranet/frontend/ /app/
RUN npm ci && npm run build

FROM nginx:alpine
# Use Render-specific nginx config (with backend URL from env)
COPY nginx.render.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html

# Expose port (Render uses PORT env var, but nginx listens on 80)
EXPOSE 80

